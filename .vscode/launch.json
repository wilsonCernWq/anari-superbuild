    "version": "0.2.0",
    "configurations": [
        {
            "name": "(Windows) Demo",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${command:cmake.buildType}/demo.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:PATH};${workspaceFolder}/build/deps/install/bin;${workspaceFolder}/build/deps/install/redist/intel64/vc14"
                }
            ],
            "console": "integratedTerminal"
        }
    ]
}
