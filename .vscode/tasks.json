{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Superbuild (config)",
            "type": "shell",
            "windows": {
                "command": "cmake",
                "args": [
                    "-S", "${workspaceFolder}/superbuild",
                    "-B", "${workspaceFolder}/build/deps",
                    "-A", "x64",
                    "-DOptiX_INSTALL_DIR='C:/ProgramData/NVIDIA Corporation/OptiX SDK 7.4.0'"
                ]
            },
            "linux": {
                "command": "cmake",
                "args": [
                    "-S", "${workspaceFolder}/superbuild",
                    "-B", "${workspaceFolder}/build/deps",
                    "-DOptiX_INSTALL_DIR=/media/data/qadwu/Software/NVIDIA-OptiX-SDK-7.4.0-linux64-x86_64"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "Superbuild (build)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build/deps",
                "--config", "Release",
                "--parallel"
            ],
            "dependsOn": [
                "Superbuild (config)",
            ],
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "CMake: configure",
            "command": "configure", 
            "dependsOn": [
                "Superbuild (build)"
            ],
            "problemMatcher": [],
            "detail": "CMake template configure task"
        }
    ]
}
