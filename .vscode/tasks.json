{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Superbuild (config)",
            "type": "shell",
            "windows": {
                "command": "cmake",
                "args": [
                    "-S", "${workspaceFolder}/superbuild",
                    "-B", "${workspaceFolder}/build/deps",
                    "-A", "x64",
                    "-DOptiX_INSTALL_DIR='C:/ProgramData/NVIDIA Corporation/OptiX SDK 7.4.0'"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "Superbuild",
            "type": "shell",
            "windows": {
                "command": "cmake",
                "args": [
                    "--build", "${workspaceFolder}/build/deps",
                    "--config", "Release",
                    "--target", "anari-visrtx",
                    "--parallel"
                ]
            },
            "dependsOrder": "sequence",
            "dependsOn": [
                "Superbuild (config)"
            ],
            "problemMatcher": []
        }
    ]
}
